# ═══════════════════════════════════════════════════════════════════════════════
# COMPOSE FILE CHAIN
# Add/remove personal stacks by including/excluding their compose file.
# Order matters: overrides must come after the base file they modify.
# ═══════════════════════════════════════════════════════════════════════════════
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:adguardhome/docker-compose.yml:tandoor/docker-compose.yml:joplin/docker-compose.yml:homeassistant/docker-compose.yml:immich/docker-compose.yml:vaultwarden/docker-compose.yml:privoxy/docker-compose.yml:compose.overrides.yml:compose.cloud.yml:compose.ai.yml:compose.monitoring.yml:compose.home-auto.yml:compose.media-extras.yml:compose.infra.yml

# Enable optional upstream profiles (comma-separated):
#   lidarr, flaresolverr, sabnzbd, calibre-web, decluttarr
# Enable optional personal profiles:
#   autobrr, cleanuparr, huntarr, cross-seed
COMPOSE_PROFILES=

# ═══════════════════════════════════════════════════════════════════════════════
# SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════
USER_ID=1000
GROUP_ID=1000
TIMEZONE="America/New_York"
CONFIG_ROOT="."
DOCKER_GID=983   # GID of the docker group on the host: run `getent group docker | cut -d: -f3`

# ═══════════════════════════════════════════════════════════════════════════════
# STORAGE PATHS
# NAS1_ROOT is your personal NAS / large-storage mount point.
# DATA_ROOT is aliased to NAS1_ROOT so the upstream base file needs no changes.
# ═══════════════════════════════════════════════════════════════════════════════
NAS1_ROOT="/mnt/nas1"
DATA_ROOT="${NAS1_ROOT}"          # alias — upstream services use DATA_ROOT
DOWNLOAD_ROOT="/mnt/data/torrents"
IMMICH_UPLOAD_LOCATION="/mnt/data/photos"

# ═══════════════════════════════════════════════════════════════════════════════
# NETWORKING / HOSTNAMES
# ═══════════════════════════════════════════════════════════════════════════════
# Public hostname (used for Traefik routing & external URLs)
HOSTNAME=example.com
BASE_HOSTNAME=example.com
# LAN-only hostname (used for services routed internally only, e.g. Calibre-Web)
LOCAL_HOSTNAME=homeserver.local
# LAN IP of the host (used for homepage direct-port widget links)
SERVER_IP=192.168.1.100

# ═══════════════════════════════════════════════════════════════════════════════
# VPN (PIA WireGuard)
# ═══════════════════════════════════════════════════════════════════════════════
PIA_LOCATION=ca
PIA_USER=
PIA_PASS=
PIA_LOCAL_NETWORK="192.168.0.0/16"

# ═══════════════════════════════════════════════════════════════════════════════
# TLS / CLOUDFLARE
# ═══════════════════════════════════════════════════════════════════════════════
DNS_CHALLENGE=true
DNS_CHALLENGE_PROVIDER=cloudflare
LETS_ENCRYPT_CA_SERVER="https://acme-v02.api.letsencrypt.org/directory"
LETS_ENCRYPT_EMAIL=
CLOUDFLARE_EMAIL=
CLOUDFLARE_DNS_API_TOKEN=
CLOUDFLARE_ZONE_API_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════════
# UPSTREAM SERVICE CREDENTIALS
# ═══════════════════════════════════════════════════════════════════════════════
SONARR_API_KEY=
RADARR_API_KEY=
LIDARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=
JELLYFIN_API_KEY=
JELLYSEERR_API_KEY=
SABNZBD_API_KEY=
IMMICH_API_KEY=
HOMEASSISTANT_ACCESS_TOKEN=
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# Upstream subdomain hostnames
HOMEASSISTANT_HOSTNAME="homeassistant.${BASE_HOSTNAME}"
IMMICH_HOSTNAME=
ADGUARD_HOSTNAME="dns.${BASE_HOSTNAME}"
JELLYSEERR_HOSTNAME="jellyseerr.${BASE_HOSTNAME}"
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════════
# HOMEPAGE
# ═══════════════════════════════════════════════════════════════════════════════
HOMEPAGE_VAR_TITLE="Home Server"
HOMEPAGE_VAR_SEARCH_PROVIDER=google
HOMEPAGE_VAR_HEADER_STYLE=boxed
HOMEPAGE_VAR_WEATHER_CITY=
HOMEPAGE_VAR_WEATHER_LAT=
HOMEPAGE_VAR_WEATHER_LONG=
HOMEPAGE_VAR_WEATHER_UNIT=metric

# ═══════════════════════════════════════════════════════════════════════════════
# UPSTREAM MISC
# ═══════════════════════════════════════════════════════════════════════════════
IMMICH_DB_PASSWORD=postgres
CALIBRE_USERNAME=admin
CALIBRE_PASSWORD=admin123
# decluttarr (upstream optional service, profile: decluttarr)
DECLUTTARR_TEST_RUN=True
DECLUTTARR_REMOVE_TIMER=60
DECLUTTARR_REMOVE_FAILED=True
DECLUTTARR_REMOVE_FAILED_IMPORTS=True
DECLUTTARR_REMOVE_METADATA_MISSING=True
DECLUTTARR_REMOVE_MISSING_FILES=True
DECLUTTARR_REMOVE_ORPHANS=True

# ═══════════════════════════════════════════════════════════════════════════════
# PERSONAL — CLOUD (compose.cloud.yml)
# ═══════════════════════════════════════════════════════════════════════════════
NEXTCLOUD_DB_ROOT_PASSWORD=
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=

# Cloudflare Tunnel
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_ID=
# Directory containing config.yml and the tunnel credentials JSON (default: ~/.cloudflared)
CLOUDFLARED_DIR=~/.cloudflared

# WireGuard (wg-easy)
WGEASY_UI_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════════
# PERSONAL — MONITORING (compose.monitoring.yml)
# ═══════════════════════════════════════════════════════════════════════════════
GRAFANA_ADMIN_PASSWORD=
GRAFANA_TOKEN=
DISCORD_WEBHOOK_URL=
GRAFANA_DASH_UID=
GRAFANA_PANEL_IDS=all

# ═══════════════════════════════════════════════════════════════════════════════
# PERSONAL — HOME AUTOMATION (compose.home-auto.yml)
# ═══════════════════════════════════════════════════════════════════════════════
# Path to Zigbee adapter device on host
ZIGBEE_ADAPTER_PATH=/dev/ttyUSB0

# ═══════════════════════════════════════════════════════════════════════════════
# PERSONAL — MEDIA EXTRAS (compose.media-extras.yml)
# ═══════════════════════════════════════════════════════════════════════════════
AUTOBRR_API_KEY=
HUNTARR_HOSTNAME="huntarr.${BASE_HOSTNAME}"

# ═══════════════════════════════════════════════════════════════════════════════
# PERSONAL — INFRASTRUCTURE (compose.infra.yml)
# ═══════════════════════════════════════════════════════════════════════════════
PORTAINER_API_KEY=
# Speedtest Tracker — generate APP_KEY at https://speedtest-tracker.dev
SPEEDTEST_APP_KEY=
SPEEDTEST_API_KEY=
SPEEDTEST_SERVER_IDS=
# Samba — single string passed to the elswork/samba container's command
# Format: -u "UID:GID:username:password:role" -s "ShareName:/share/folder:rw:username"
SAMBA_CONFIG='-u "1000:1000:user:changeme:pirate" -s "SmbShare:/share/folder:rw:user"'
