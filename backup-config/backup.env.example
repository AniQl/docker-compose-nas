# Config-only backup environment.
# Copy to backup-config/backup.env and keep it out of git.

# Encrypted Restic repository stored directly in Google Drive through rclone.
# Create an rclone remote named "gdrive" first.
RESTIC_REPOSITORY=rclone:gdrive:/docker-compose-nas/config-backups

# Generate with: openssl rand -base64 32
# Store this password outside this machine too.
RESTIC_PASSWORD=

# 5-field cron syntax. Default: 03:30 daily.
BACKUP_CRON="30 3 * * *"

# Run one backup immediately when the daemon container starts.
RUN_ON_STARTUP=false

# Config snapshot retention.
RESTIC_FORGET_ARGS="--keep-last 14 --keep-daily 14 --keep-weekly 8 --keep-monthly 12"

# Home Assistant backup archive retention. These tar files are already compressed,
# so keep fewer snapshots than normal config backups.
HA_RESTIC_FORGET_ARGS="--keep-last 3 --keep-daily 3"
